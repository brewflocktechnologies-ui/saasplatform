{
  "name": "chat-platform",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "nx run-many -t dev -p chatdashboardapp chatwidget modulithplatformservice --parallel=3",
    "dev:dashboard": "nx run chatdashboardapp:dev",
    "dev:widget": "nx run chatwidget:dev",
    "dev:backend": "nx run modulithplatformservice:dev",
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "e2e": "nx run platform-tests:e2e",
    "contracts:validate": "nx run contracts:validate",
    "db:info": "nx run flyway-migration:info",
    "db:validate": "nx run flyway-migration:validate",
    "db:migrate": "nx run flyway-migration:migrate",
    "compose:validate": "docker compose config -q && docker compose -f docker-compose.yml -f docker-compose.apps.yml config -q",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down",
    "stack:up": "docker compose -f docker-compose.yml -f docker-compose.apps.yml up --build -d --wait",
    "stack:down": "docker compose -f docker-compose.yml -f docker-compose.apps.yml down",
    "verify": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-local.ps1"
  },
  "dependencies": {
    "lit": "3.3.3",
    "next": "~16.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "16.4.3",
    "@nx/eslint": "24.0.1",
    "@nx/eslint-plugin": "24.0.1",
    "@nx/js": "24.0.1",
    "@nx/next": "24.0.1",
    "@nx/playwright": "24.0.1",
    "@nx/react": "24.0.1",
    "@nx/vite": "24.0.1",
    "@nx/vitest": "24.0.1",
    "@nx/web": "24.0.1",
    "@nx/workspace": "24.0.1",
    "@playwright/test": "1.64.1",
    "@redocly/cli": "^2.71.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~5.0.1",
    "@vitest/ui": "~5.0.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.8.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "nx": "24.0.1",
    "prettier": "~3.6.2",
    "swc-loader": "0.1.15",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~5.0.1",
    "yaml": "^2.9.1"
  }
}
