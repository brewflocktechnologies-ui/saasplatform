{
  "name": "contracts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/contracts",
  "tags": ["type:contracts", "platform:shared"],
  "targets": {
    "validate": {
      "command": "redocly lint libs/contracts/openapi/platform-api.yaml --config libs/contracts/redocly.yaml",
      "options": { "cwd": "{workspaceRoot}" },
      "inputs": ["{projectRoot}/**/*"],
      "cache": true
    }
  }
}
