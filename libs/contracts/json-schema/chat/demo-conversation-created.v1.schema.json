{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chat-platform.local/chat/demo-conversation-created.v1.schema.json",
  "title": "ConversationCreatedEvent",
  "description": "Published on chat:inbox when the demo conversation is created.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "conversation"
  ],
  "properties": {
    "type": {
      "const": "conversation.created"
    },
    "conversation": {
      "$ref": "demo-conversation.v1.schema.json"
    }
  }
}
