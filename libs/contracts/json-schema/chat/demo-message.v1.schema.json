{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chat-platform.local/chat/demo-message.v1.schema.json",
  "title": "ChatMessage",
  "description": "A persisted chat message (also the `message` payload of message.created).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "conversationId",
    "senderId",
    "senderRole",
    "body",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "conversationId": {
      "type": "string",
      "format": "uuid"
    },
    "senderId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "senderRole": {
      "type": "string",
      "enum": [
        "VISITOR",
        "AGENT"
      ]
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "id": "019a1b2c-3d4e-7f80-9a1b-2c3d4e5f6071",
      "conversationId": "019a1b2c-0000-7000-8000-000000000001",
      "senderId": "userone",
      "senderRole": "VISITOR",
      "body": "Hello, can you help me?",
      "createdAt": "2026-10-25T12:00:00Z"
    }
  ]
}
