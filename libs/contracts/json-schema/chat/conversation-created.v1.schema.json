{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chat-platform.local/chat/conversation-created.v1.schema.json",
  "title": "ConversationCreatedEvent",
  "description": "Published on chat:inbox:<tenant>:<inbox> when a conversation is created. The conversation object has no per-caller fields and its assignment has exactly state and agentId.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "tenantId", "conversationId", "occurredAt", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "conversation.created" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 63 },
    "conversationId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation"],
      "properties": { "conversation": { "$ref": "#/definitions/eventConversation" } }
    }
  },
  "definitions": {
    "eventConversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "inboxId", "contactId", "contactDisplayName", "status", "version", "lastSequence",
                   "lastMessageAt", "lastMessagePreview", "assignment", "resolvedAt", "archivedAt", "purgedAt",
                   "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 63 },
        "inboxId": { "type": "string", "format": "uuid" },
        "contactId": { "type": "string", "format": "uuid" },
        "contactDisplayName": { "type": ["string", "null"], "maxLength": 200 },
        "status": { "type": "string", "enum": ["OPEN", "PENDING", "RESOLVED"] },
        "version": { "type": "integer", "minimum": 0 },
        "lastSequence": { "type": "integer", "minimum": 0 },
        "lastMessageAt": { "type": ["string", "null"], "format": "date-time" },
        "lastMessagePreview": { "type": ["string", "null"], "maxLength": 120 },
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "agentId"],
          "properties": {
            "state": { "type": "string", "enum": ["NONE", "REQUESTED", "QUEUED", "ASSIGNED", "RELEASE_PENDING", "REOPEN_PENDING", "FAILED"] },
            "agentId": { "type": ["string", "null"], "maxLength": 128 }
          },
          "description": "ContactAssignmentView: exactly state and agentId; routing details never reach the visitor channel."
        },
        "resolvedAt": { "type": ["string", "null"], "format": "date-time" },
        "archivedAt": { "type": ["string", "null"], "format": "date-time" },
        "purgedAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "examples": [
    {
      "eventId": "019a1b2c-0000-7000-8000-000000000012",
      "eventType": "conversation.created",
      "schemaVersion": 1,
      "tenantId": "tenant-local",
      "conversationId": "019a1b2c-0000-7000-8000-000000000001",
      "occurredAt": "2026-10-27T12:00:00Z",
      "data": {
        "conversation": {
          "id": "019a1b2c-0000-7000-8000-000000000001",
          "tenantId": "tenant-local",
          "inboxId": "019a1b2c-0000-7000-8000-000000000002",
          "contactId": "019a1b2c-0000-7000-8000-000000000003",
          "contactDisplayName": "User One",
          "status": "OPEN",
          "version": 0,
          "lastSequence": 0,
          "lastMessageAt": null,
          "lastMessagePreview": null,
          "assignment": { "state": "REQUESTED", "agentId": null },
          "resolvedAt": null,
          "archivedAt": null,
          "purgedAt": null,
          "createdAt": "2026-10-27T12:00:00Z",
          "updatedAt": "2026-10-27T12:00:00Z"
        }
      }
    }
  ]
}
