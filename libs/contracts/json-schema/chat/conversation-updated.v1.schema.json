{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.chat-platform.local/chat/conversation-updated.v1.schema.json",
  "title": "ConversationUpdatedEvent",
  "description": "Published on chat:conversation:<id> and chat:inbox:<tenant>:<inbox> for every state write and assignment projection change (one event per version increment).",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "tenantId", "conversationId", "occurredAt", "data"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "conversation.updated" },
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "tenantId": { "type": "string", "minLength": 1, "maxLength": 63 },
    "conversationId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation", "change"],
      "properties": {
        "conversation": { "$ref": "#/definitions/eventConversation" },
        "change": {
          "type": "string",
          "enum": ["ASSIGNED", "RESOLVED", "REOPENED", "PENDING", "ARCHIVED", "UNARCHIVED", "ASSIGNMENT_QUEUED",
                   "ASSIGNMENT_FAILED", "ASSIGNMENT_UPDATED"]
        }
      }
    }
  },
  "definitions": {
    "eventConversation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenantId", "inboxId", "contactId", "contactDisplayName", "status", "version", "lastSequence",
                   "lastMessageAt", "lastMessagePreview", "assignment", "resolvedAt", "archivedAt", "purgedAt",
                   "createdAt", "updatedAt"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "tenantId": { "type": "string", "minLength": 1, "maxLength": 63 },
        "inboxId": { "type": "string", "format": "uuid" },
        "contactId": { "type": "string", "format": "uuid" },
        "contactDisplayName": { "type": ["string", "null"], "maxLength": 200 },
        "status": { "type": "string", "enum": ["OPEN", "PENDING", "RESOLVED"] },
        "version": { "type": "integer", "minimum": 0 },
        "lastSequence": { "type": "integer", "minimum": 0 },
        "lastMessageAt": { "type": ["string", "null"], "format": "date-time" },
        "lastMessagePreview": { "type": ["string", "null"], "maxLength": 120 },
        "assignment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "agentId"],
          "properties": {
            "state": { "type": "string", "enum": ["NONE", "REQUESTED", "QUEUED", "ASSIGNED", "RELEASE_PENDING", "REOPEN_PENDING", "FAILED"] },
            "agentId": { "type": ["string", "null"], "maxLength": 128 }
          }
        },
        "resolvedAt": { "type": ["string", "null"], "format": "date-time" },
        "archivedAt": { "type": ["string", "null"], "format": "date-time" },
        "purgedAt": { "type": ["string", "null"], "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "examples": [
    {
      "eventId": "019a1b2c-0000-7000-8000-000000000013",
      "eventType": "conversation.updated",
      "schemaVersion": 1,
      "tenantId": "tenant-local",
      "conversationId": "019a1b2c-0000-7000-8000-000000000001",
      "occurredAt": "2026-10-27T12:01:00Z",
      "data": {
        "conversation": {
          "id": "019a1b2c-0000-7000-8000-000000000001",
          "tenantId": "tenant-local",
          "inboxId": "019a1b2c-0000-7000-8000-000000000002",
          "contactId": "019a1b2c-0000-7000-8000-000000000003",
          "contactDisplayName": "User One",
          "status": "RESOLVED",
          "version": 2,
          "lastSequence": 3,
          "lastMessageAt": "2026-10-27T12:00:00Z",
          "lastMessagePreview": "Hello!",
          "assignment": { "state": "RELEASE_PENDING", "agentId": "agentbob" },
          "resolvedAt": "2026-10-27T12:01:00Z",
          "archivedAt": null,
          "purgedAt": null,
          "createdAt": "2026-10-27T12:00:00Z",
          "updatedAt": "2026-10-27T12:01:00Z"
        },
        "change": "RESOLVED"
      }
    }
  ]
}
