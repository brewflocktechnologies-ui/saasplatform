{
  "log": {
    "level": "info"
  },
  "http_server": {
    "port": "8000"
  },
  "client": {
    "allowed_origins": ["http://localhost:3000", "http://localhost:5173"],
    "subscription_token": {
      "enabled": true
    }
  },
  "channel": {
    "namespaces": [
      {
        "name": "chat",
        "history_size": 100,
        "history_ttl": "300s",
        "force_recovery": true
      }
    ]
  },
  "admin": {
    "enabled": false
  },
  "health": {
    "enabled": true
  }
}
