# Local development configuration. Copy to .env with scripts/dev-setup.ps1 (generates random dev-only secrets).
# Values below are PLACEHOLDERS, not usable credentials. Never commit .env.
# This file is also the authoritative local port map; change a port here and docs/setup/local-development.md together.

COMPOSE_PROJECT_NAME=chat-platform

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=chatplatform
# Superuser used only by the postgres container itself (init scripts, admin tasks).
POSTGRES_ADMIN_USER=platform_admin
POSTGRES_ADMIN_PASSWORD=__generate__
# DDL owner, used only by the Flyway migration runner.
POSTGRES_MIGRATOR_USER=platform_migrator
POSTGRES_MIGRATOR_PASSWORD=__generate__
# Least-privilege runtime role (DML only), used by modulithplatformservice.
POSTGRES_APP_USER=platform_app
POSTGRES_APP_PASSWORD=__generate__

# --- Centrifugo (local-only secrets, backend + Centrifugo only; never in browser config) ----
CENTRIFUGO_CLIENT_TOKEN_HMAC_SECRET_KEY=__generate__
CENTRIFUGO_CLIENT_SUBSCRIPTION_TOKEN_HMAC_SECRET_KEY=__generate__
CENTRIFUGO_HTTP_API_KEY=__generate__

# --- Grafana ------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__generate__

# --- Backend / frontends -------------------------------------------------------
APP_ENVIRONMENT=local
# Session JWTs for contacts and agents (LOCAL POC — NOT REAL AUTHENTICATION yet, ADR-0008). 32+ characters.
APP_SESSION_TOKEN_HMAC_SECRET_KEY=__generate__
# X-Admin-Token for the local-dev admin API (only served while APP_LOCAL_DEV_ENABLED=true).
APP_LOCAL_ADMIN_TOKEN=__generate__
APP_LOCAL_DEV_ENABLED=true
# Inbox widget key seeded for the local tenant (public identifier, not a secret).
APP_SEED_WIDGET_KEY=wk_local_demo
# --- Allocation service (Plan 04) ----------------------------------------------
ALLOCATION_DB_PASSWORD=__generate__
ALLOCATION_URL=http://localhost:8081
ALLOCATION_HOST_PORT=8081
ALLOCATION_DB_HOST_PORT=5433
ALLOCATION_ENGINE_DIR=../RESEARCH/Allocationservice-research/allocation-engine
# Browser-facing URLs: must be resolvable from the host browser (never a Compose service name).
PUBLIC_API_BASE_URL=http://localhost:8080
PUBLIC_WIDGET_DEMO_URL=http://localhost:5173
PUBLIC_CENTRIFUGO_WS_URL=ws://localhost:8000/connection/websocket
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Host port map (all bound to 127.0.0.1) ------------------------------------
DASHBOARD_HOST_PORT=3000
WIDGET_HOST_PORT=5173
BACKEND_HOST_PORT=8080
POSTGRES_HOST_PORT=5432
CENTRIFUGO_HOST_PORT=8000
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3001
LOKI_HOST_PORT=3100
TEMPO_HOST_PORT=3200
OTEL_GRPC_HOST_PORT=4317
OTEL_HTTP_HOST_PORT=4318
OTEL_HEALTH_HOST_PORT=13133
